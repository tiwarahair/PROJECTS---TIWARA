# Copy to supabase/.env and supabase/functions/.env (both gitignored) for the local stack.
# Cloudflare Turnstile test secret: always passes.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Shared secret pg_cron sends to purge-closed-businesses; store the same value in Vault as cron_secret.
CRON_SECRET=
