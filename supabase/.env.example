# Copy to supabase/.env and supabase/functions/.env (both gitignored) for the local stack.
# Cloudflare Turnstile test secret: always passes.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Shared secret pg_cron sends to purge-closed-businesses and send-notifications; store the same value
# in Vault as cron_secret.
CRON_SECRET=

# AES-256 key for NI numbers in save-tax-details: 32 random bytes, base64 (openssl rand -base64 32).
TAX_ENCRYPTION_KEY=

# Stripe test keys (sk_test_…) and the webhook signing secret (whsec_…); set on staging with yarn supabase secrets set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The payments endpoint's own signing secret (payment_intent.succeeded and payment_intent.payment_failed).
STRIPE_PAYMENTS_WEBHOOK_SECRET=

# Resend API key for send-notifications (staging/production only). Leave empty locally: emails then go to Mailpit
# (http://127.0.0.1:54324) and never out for real.
RESEND_API_KEY=
