{
  "name": "tiwaras-house",
  "version": "1.0.0",
  "type": "module",
  "repository": "https://github.com/tiwarahair/PROJECTS---TIWARA.git",
  "author": "Kashope Afolabi & Faith Odularu",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p api",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src supabase/functions",
    "images": "node scripts/build-images.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "(echo '// Generated by yarn db:types from the local database. Do not edit: change a migration, then run it again.' && supabase gen types typescript --local) > src/types/database.ts && prettier --write src/types/database.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^5.7.1",
    "@marsidev/react-turnstile": "^1.6.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@stripe/react-stripe-js": "7.0.0",
    "@stripe/stripe-js": "10.1.0",
    "@supabase/supabase-js": "^2.117.3",
    "@vis.gl/react-google-maps": "^1.10.1",
    "@zxcvbn-ts/core": "3.0.4",
    "@zxcvbn-ts/language-common": "3.0.4",
    "@zxcvbn-ts/language-en": "3.0.2",
    "browser-image-compression": "^2.0.2",
    "gsap": "3.12.5",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-loading-skeleton": "^3.5.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.0",
    "prettier": "3.9.6",
    "supabase": "^2.120.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
